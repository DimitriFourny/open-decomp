{
  "name": "open-decomp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless native binary analysis and homemade decompilation for LLM clients",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "open-decomp": "./dist/src/mcp/stdio.js"
  },
  "files": [
    "dist/src",
    "vendor",
    "PLAN.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test && npm run build",
    "smoke": "node dist/scripts/smoke.js",
    "mcp": "node dist/src/mcp/stdio.js",
    "smoke:mcp": "node dist/scripts/mcp-smoke.js"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.19.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "gecko-profiler-demangle": "0.4.0",
    "iced-x86": "1.21.0",
    "llvm-msvc-demangle": "0.2.0",
    "swift-demangle-wasm": "1.0.2",
    "zod": "4.6.7"
  }
}
