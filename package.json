{
  "name": "open-decomp",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "bun@1.4.3",
  "bundleDependencies": true,
  "type": "module",
  "description": "Headless native binary analysis and homemade decompilation for LLM clients",
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./api": {
      "types": "./dist/src/api/index.d.ts",
      "import": "./dist/src/api/index.js"
    }
  },
  "bin": {
    "open-decomp": "./dist/src/cli/entry.js"
  },
  "files": [
    "dist/src",
    "dist/vendor/a64js",
    "vendor/a64js/LICENSE",
    "vendor/a64js/README.md",
    "vendor/a64js/snapshot.json",
    "README.md",
    "API.md",
    "REMOTE.md",
    "THIRD-PARTY-NOTICES.md",
    "licenses",
    "PERFORMANCE.md",
    "src/core/README.md",
    "src/decoders/arm64/README.md",
    "src/decoders/x86_64/README.md",
    "fixtures/README.md",
    "fixtures/LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "check": "bun run typecheck && bun run test && bun run build",
    "smoke": "node dist/scripts/smoke.js",
    "mcp": "node dist/src/cli/entry.js mcp start",
    "mcp:http": "node dist/src/cli/entry.js mcp start --transport http",
    "smoke:mcp": "node dist/scripts/mcp-smoke.js",
    "pack:release": "node --import tsx scripts/package-release.ts",
    "verify:installed": "node --import tsx scripts/installed-acceptance.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.19.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "gecko-profiler-demangle": "0.4.0",
    "iced-x86": "1.21.0",
    "llvm-msvc-demangle": "0.2.0",
    "swift-demangle-wasm": "1.0.2",
    "zod": "4.6.7"
  }
}
