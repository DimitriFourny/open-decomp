{
  "name": "open-decomp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "packageManager": "bun@1.4.3",
  "bundleDependencies": true,
  "type": "module",
  "description": "Headless native binary analysis and homemade decompilation for LLM clients",
  "keywords": [
    "decompiler",
    "reverse-engineering",
    "binary-analysis",
    "disassembler",
    "mach-o",
    "pe",
    "elf",
    "arm64",
    "x86-64",
    "mcp",
    "llm"
  ],
  "homepage": "https://github.com/DimitriFourny/open_decomp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DimitriFourny/open_decomp.git"
  },
  "bugs": {
    "url": "https://github.com/DimitriFourny/open_decomp/issues"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./api": {
      "types": "./dist/src/api/index.d.ts",
      "import": "./dist/src/api/index.js"
    }
  },
  "bin": {
    "open-decomp": "./dist/src/cli/entry.js"
  },
  "files": [
    "dist/src",
    "dist/vendor/a64js",
    "vendor/a64js/LICENSE",
    "vendor/a64js/README.md",
    "vendor/a64js/snapshot.json",
    "README.md",
    "LICENSE",
    "docs",
    "licenses",
    "fixtures/LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bench": "node --import tsx scripts/bench/odbench/cli.ts",
    "format": "node --import tsx scripts/format.ts",
    "format:check": "node --import tsx scripts/format.ts --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx scripts/test.ts all",
    "test:unit": "node --import tsx scripts/test.ts unit",
    "test:integration": "node --import tsx scripts/test.ts integration",
    "fingerprints": "node --import tsx scripts/output-fingerprints.ts",
    "prototypes": "node --import tsx scripts/generate-library-prototypes.ts",
    "check": "bun run typecheck && bun run format:check && bun run test:unit && bun run test:integration && bun run build",
    "cli": "node dist/src/cli/entry.js",
    "smoke": "node dist/scripts/smoke.js",
    "mcp": "node dist/src/cli/entry.js mcp start",
    "mcp:http": "node dist/src/cli/entry.js mcp start --transport http",
    "smoke:mcp": "node dist/scripts/mcp-smoke.js",
    "pack:release": "node --import tsx scripts/package-release.ts",
    "verify:installed": "node --import tsx scripts/installed-acceptance.ts"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "24.19.2",
    "@typescript-eslint/parser": "8.71.2",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "dependencies": {
    "@modelcontextprotocol/core": "2.3.1",
    "@modelcontextprotocol/server": "2.3.1",
    "gecko-profiler-demangle": "0.4.0",
    "iced-x86": "1.21.0",
    "llvm-msvc-demangle": "0.2.0",
    "swift-demangle-wasm": "1.0.2",
    "zod": "4.6.7"
  }
}
